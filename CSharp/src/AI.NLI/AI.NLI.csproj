<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AI.NLI</PackageId>
    <Description>Естественно-языковой интерфейс для экспертных систем: заполнение формы входа по тексту и объяснение выхода.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AIFramework/AI.NLI</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Доступ к модели через стандартный IChatClient: подойдет любой провайдер, свой порт не нужен -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.4.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
